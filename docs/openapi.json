{
  "openapi": "3.1.0",
  "info": {
    "title": "LanQin Email Open API",
    "version": "1.0.0",
    "description": "Versioned integration API. The unversioned /api/open routes are compatibility aliases for /api/open/v1."
  },
  "servers": [{ "url": "/api/open/v1" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/me/external-mail-providers": {"servers": [{"url": "/api"}], "get": {"security": [{"browserSession": []}], "description": "Same session authentication, mail access permission and external IMAP feature gate as account management. Returns public metadata only.", "responses": {"200": {"description": "Mail provider presets", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/ExternalMailProvider"}}}}}}}, "401": {"description": "Unauthenticated"}, "403": {"description": "Mail access denied or external IMAP disabled"}}}},
    "/me/external-imap-accounts/{id}/sends": {"servers": [{"url": "/api"}], "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "get": {"security": [{"browserSession": []}], "description": "Owner only, mail access permission and external IMAP enabled. No shared-mailbox authorization.", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}}], "responses": {"200": {"description": "External send records", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/ExternalSend"}}}}}}}, "404": {"description": "Account not found or not owned"}, "403": {"description": "Mail access denied or external IMAP disabled"}}}},
    "/me/external-imap-accounts/{id}/sends/{sendId}/resolve": {"servers": [{"url": "/api"}], "parameters": [{"$ref": "#/components/parameters/ResourceId"}, {"name": "sendId", "in": "path", "required": true, "schema": {"type": "string"}}], "post": {"security": [{"browserSession": []}], "description": "Owner only, mail access and external IMAP enabled. Only unconfirmed may be resolved. delivered marks acceptance (and schedules APPEND if configured); retry explicitly accepts possible duplicate delivery.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string", "enum": ["delivered", "retry"]}}}}}}, "responses": {"200": {"description": "Resolved", "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}}}}}}, "400": {"description": "Invalid action"}, "404": {"description": "Account/send not found or not owned"}, "409": {"description": "Send is not unconfirmed"}}}},
    "/mail/send": {"servers": [{"url": "/api"}], "post": {"security": [{"browserSession": []}], "description": "Mail send permission required. External send requires owned active mailbox and enabled owned account, sendEnabled, authStatus=ok and valid sender. Shared users denied. External route never writes local Sent. Attachments, max 100 recipients and SMTP rate limits still apply. DATA network ambiguity becomes unconfirmed without automatic retry.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebmailComposeRequest"}}}}, "responses": {"201": {"description": "Local MailMessage (existing behavior)"}, "202": {"description": "Queued external send", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalQueuedSend"}}}}, "400": {"description": "Invalid recipients, attachments or MIME"}, "403": {"description": "external account cannot send"}, "429": {"description": "SMTP rate limit exceeded"}}}},
    "/mail/schedule-send": {"servers": [{"url": "/api"}], "post": {"security": [{"browserSession": []}], "description": "Mail send and schedule permissions required. externalAccountId is persisted in payload JSON and reauthorized at execution; unavailable sender marks schedule failed.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/WebmailComposeRequest"}, {"type": "object", "required": ["sendAt"], "properties": {"sendAt": {"type": "string", "format": "date-time"}, "draftId": {"type": "string"}}}]}}}}, "responses": {"201": {"description": "Scheduled send; includes externalAccountId when supplied"}, "400": {"description": "Invalid time, recipients or attachments"}, "403": {"description": "external account cannot send"}}}},
    "/mail/drafts": {"servers": [{"url": "/api"}], "post": {"security": [{"browserSession": []}], "description": "Mail drafts permission required. externalAccountId accepted/validated; currently not persisted in draft storage.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebmailDraftRequest"}}}}, "responses": {"201": {"description": "Draft MailMessage"}, "403": {"description": "external account cannot send"}}}},
    "/mail/drafts/{id}": {"servers": [{"url": "/api"}], "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "post": {"security": [{"browserSession": []}], "description": "Update owned draft; externalAccountId is validated but not persisted/read back.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebmailDraftRequest"}}}}, "responses": {"200": {"description": "Draft MailMessage"}, "403": {"description": "external account cannot send"}, "404": {"description": "Draft not found"}}}},
    "/admin/delivery-queue": {"servers": [{"url": "/api"}], "get": {"security": [{"browserSession": []}], "description": "Admin settings view permission. Sanitized metadata only.", "parameters": [{"name": "status", "in": "query", "schema": {"type": "string", "enum": ["all", "pending", "failed", "delivered", "canceled", "unconfirmed"]}}, {"name": "queueType", "in": "query", "schema": {"type": "string", "enum": ["all", "send", "webhook", "telegram"]}}, {"$ref": "#/components/parameters/Limit"}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "Queue page", "content": {"application/json": {"schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/AdminDeliveryQueueItem"}}, "page": {"type": "integer"}, "limit": {"type": "integer"}, "totalCount": {"type": "integer"}}}}}}}}},
    "/admin/delivery-queue/{queueType}/{id}/retry": {"servers": [{"url": "/api"}], "parameters": [{"$ref": "#/components/parameters/ResourceId"}, {"name": "queueType", "in": "path", "required": true, "schema": {"type": "string", "enum": ["send", "webhook", "telegram"]}}], "post": {"security": [{"browserSession": []}], "description": "Admin settings update permission. Retryable external failures with retained MIME preserve the external route. Permanent external failures with cleared MIME require recomposing; unconfirmed can only be resolved by the owner.", "responses": {"200": {"description": "Requeued"}, "409": {"description": "Ineligible, leased, delivered, unconfirmed, or external MIME already cleared"}}}},
    "/me/external-imap-oauth/{provider}/start": {"servers": [{"url": "/api"}], "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["gmail", "outlook"]}}], "post": {"security": [{"browserSession": []}], "description": "Browser session, mail access permission, external IMAP enabled. Optional accountId reauthorizes an owned OAuth2 account of this provider; another user account returns 404. New connections require an owned mailboxId; reauthorization defaults to the current mailbox and preserves account metadata. Sets an HttpOnly browser binding cookie. PKCE S256, OIDC nonce, consent; Gmail offline access.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalIMAPOAuthStart"}}}}, "responses": {"200": {"description": "Authorization URL; Set-Cookie binds this browser", "content": {"application/json": {"schema": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}}}}}}, "400": {"description": "Invalid input, non-OAuth account, provider mismatch or provider not configured"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"description": "Mail access denied or external IMAP disabled"}, "404": {"description": "Account/mailbox not found or not owned"}}}},
    "/external-imap-oauth/{provider}/callback": {"servers": [{"url": "/api"}], "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["gmail", "outlook"]}}], "get": {"security": [], "description": "Single-use database state and browser binding cookie required; PKCE verifier and OIDC iss/aud/exp/nonce validation. Reauthorization requires the same sub (legacy accounts: same stored OAuth email). Clears cookie. All outcomes redirect with a fixed result code; no provider error text.", "parameters": [{"name": "state", "in": "query", "schema": {"type": "string"}}, {"name": "code", "in": "query", "schema": {"type": "string"}}, {"name": "error", "in": "query", "schema": {"type": "string"}}], "responses": {"302": {"description": "Redirect to {PublicBaseURL}/profile?tab=mailboxes&externalMail=<code>", "headers": {"Location": {"schema": {"type": "string"}, "description": "externalMail is connected, reauthorized, denied, invalid_state, email_mismatch, account_mismatch, exchange_failed, not_configured or failed."}}}}}},
    "/me/external-imap-accounts": {"servers": [{"url": "/api"}], "get": {"security": [{"browserSession": []}], "description": "Owned external accounts; requires mail access and external IMAP enabled.", "parameters": [{"name": "mailboxId", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Account list", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/ExternalIMAPAccount"}}}}}}}}}, "post": {"security": [{"browserSession": []}], "description": "Owned mailbox; requires mail access and external IMAP enabled. SMTP settings errors: external smtp settings are incomplete, external smtp requires tls, external send address is invalid.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalIMAPAccountCreate"}}}}, "responses": {"201": {"description": "Created external account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalIMAPAccount"}}}}, "400": {"description": "Invalid IMAP/SMTP settings or SSRF rejected; unknown mail provider or oauth account provider does not match"}, "404": {"description": "Owned mailbox not found"}}}},
    "/me/external-imap-accounts/{id}": {"servers": [{"url": "/api"}], "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "post": {"security": [{"browserSession": []}], "description": "Owned account, mail access and external IMAP enabled. OAuth endpoints and credentials pinned; different endpoint fields return 400 oauth account endpoints cannot be changed. SMTP password empty retains existing secret; absent SMTP password falls back to IMAP password. Metadata, sendEnabled and sentCopyMode remain editable.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalIMAPAccountUpdate"}}}}, "responses": {"200": {"description": "Updated account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalIMAPAccount"}}}}, "400": {"description": "Invalid input or oauth account endpoints cannot be changed; unknown mail provider or oauth account provider does not match"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"security": [{"browserSession": []}], "description": "Owner only. Atomically permanently fails queued and retryable failed external sends with lastError=external account removed, then deletes the account. No relay fallback.", "responses": {"200": {"description": "Deleted"}, "404": {"description": "Account not found or not owned"}}}},
    "/domains/{id}/collection": {"parameters": [{"$ref": "#/components/parameters/ResourceId"}], "get": {"description": "Administrator with domain view permission and domains:read scope. Unconfigured domains return disabled.", "responses": {"200": {"description": "Domain collection configuration", "content": {"application/json": {"schema": {"type": "object", "required": ["enabled", "targetMailboxId"], "properties": {"enabled": {"type": "boolean"}, "targetMailboxId": {"type": "string", "description": "Active mailbox ID on this server; may be in another local domain. Empty when disabled."}}}}}}, "403": {"description": "Forbidden"}, "404": {"description": "Domain not found"}}}, "post": {"description": "Administrator with domain update permission and domains:write scope. Retains originals. Audits actor and previous/new mailbox IDs.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["enabled", "targetMailboxId"], "properties": {"enabled": {"type": "boolean"}, "targetMailboxId": {"type": "string", "description": "Active mailbox ID on this server; may be in another local domain. Empty when disabled."}}}}}}, "responses": {"200": {"description": "Domain collection configuration", "content": {"application/json": {"schema": {"type": "object", "required": ["enabled", "targetMailboxId"], "properties": {"enabled": {"type": "boolean"}, "targetMailboxId": {"type": "string", "description": "Active mailbox ID on this server; may be in another local domain. Empty when disabled."}}}}}}, "400": {"description": "Inactive/non-local target or forwarding alias"}, "403": {"description": "Forbidden"}, "404": {"description": "Domain not found"}}}},
    "/domain-collection-targets": {"get": {"description": "Administrator, domain view permission and domains:read. All eligible active local mailbox IDs and addresses, across local domains.", "responses": {"200": {"description": "Target list: items with id and address"}}}},
    "/local-delivery-jobs": {"get": {"description": "Administrator, domain view permission and domains:read. Latest 100 local delivery jobs. Does not include Postfix delivery status or message content. Terminal metadata retained for 30 days.", "responses": {"200": {"description": "items: id, targetMailboxId, status (queued/sending/delivered/failed), attempts, lastError, createdAt, updatedAt"}}}},
    "/domains": { "get": { "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Paginated domains" } } }, "post": { "responses": { "201": { "description": "Domain created" } } } },
    "/domains/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Domain" }, "404": { "$ref": "#/components/responses/NotFound" } } }, "post": { "responses": { "200": { "description": "Domain updated" } } }, "delete": { "responses": { "200": { "description": "Domain deleted" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/domains/{id}/dns-records": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Required DNS records" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/domains/{id}/dns-check": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "post": { "responses": { "200": { "description": "DNS check result" } } } },
    "/mailboxes": { "get": { "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Paginated mailboxes" } } }, "post": { "responses": { "201": { "description": "Mailbox created" } } } },
    "/mailboxes/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Mailbox" }, "404": { "$ref": "#/components/responses/NotFound" } } }, "post": { "responses": { "200": { "description": "Mailbox updated" } } }, "delete": { "responses": { "200": { "description": "Mailbox deleted" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/mailboxes/{id}/password": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "post": { "description": "Resets the owner user's password and every mailbox password they own. Also ends all of that user's sessions and disables their API tokens.", "responses": { "200": { "description": "Owner and mailbox passwords reset; sessions and API tokens revoked" } } } },
    "/mailboxes/{id}/messages": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "get": { "responses": { "200": { "description": "Paginated messages" } } } },
    "/messages/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Message detail" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/attachments/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Attachment bytes" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/send": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Paginated sends" } } },
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendRequest" } } } },
        "responses": { "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendStatus" } } } }, "201": { "description": "Queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendStatus" } } } }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/send/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Send status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendStatus" } } } }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/send/{id}/events": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Queue audit and delivery events" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/send/{id}/retry": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "post": { "responses": { "200": { "description": "Send requeued" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/send/{id}/cancel": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "post": { "responses": { "200": { "description": "Send canceled" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/aliases": { "get": { "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Paginated aliases" } } }, "post": { "responses": { "201": { "description": "Alias created" } } } },
    "/aliases/{id}": { "parameters": [{ "$ref": "#/components/parameters/ResourceId" }], "get": { "responses": { "200": { "description": "Alias" }, "404": { "$ref": "#/components/responses/NotFound" } } }, "post": { "responses": { "200": { "description": "Alias updated" } } }, "delete": { "responses": { "200": { "description": "Alias deleted" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/delivery-events": {
      "post": {
        "security": [],
        "description": "HMAC-SHA256 signed delivery event callback. Sign timestamp + '.' + raw body.",
        "parameters": [
          { "name": "X-LanQin-Timestamp", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-LanQin-Signature", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^sha256=[a-f0-9]{64}$" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["events"], "properties": { "events": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/DeliveryEventInput" } } } } } } },
        "responses": { "200": { "description": "Events stored or deduplicated" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "browserSession": { "type": "apiKey", "in": "cookie", "name": "lanqin_session", "description": "Browser session cookie; actual name is configurable with CookieName. These routes do not accept integration API tokens." }, "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "lq_* API Token" } },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Up to 128 characters; retained for 24 hours.", "schema": { "type": "string", "maxLength": 128 } },
      "ResourceId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid authentication" },
      "NotFound": { "description": "Resource not found or not owned by the token user" },
      "Conflict": { "description": "Idempotency key conflict or concurrent state change" }
    },
    "schemas": {
      "ExternalMailProvider": {"type": "object", "required": ["id", "name", "oauthProvider", "imapHost", "imapTlsMode", "smtpHost", "smtpTlsMode", "sentCopyMode", "authMethods", "oauthConfigured", "imapPort", "smtpPort", "requiresImapId"], "properties": {"id": {"type": "string", "enum": ["gmail", "outlook", "yahoo", "icloud", "qq", "163", "custom"]}, "name": {"type": "string"}, "oauthProvider": {"type": "string", "enum": ["gmail", "outlook", ""]}, "imapHost": {"type": "string"}, "imapTlsMode": {"type": "string", "enum": ["tls", "starttls"]}, "smtpHost": {"type": "string"}, "smtpTlsMode": {"type": "string", "enum": ["tls", "starttls"]}, "sentCopyMode": {"type": "string", "enum": ["server", "append"]}, "authMethods": {"type": "array", "items": {"type": "string", "enum": ["oauth2", "app_password"]}, "minItems": 1}, "oauthConfigured": {"type": "boolean", "description": "True only if the corresponding administrator client ID and secret are both configured. No credentials are returned."}, "imapPort": {"type": "integer", "minimum": 0, "maximum": 65535}, "smtpPort": {"type": "integer", "minimum": 0, "maximum": 65535}, "requiresImapId": {"type": "boolean"}}, "description": "Seven ordered presets: gmail, outlook, yahoo, icloud, qq, 163, custom. Custom hosts are empty strings and ports are 0. append defaults await manual account verification."},
      "ExternalIMAPAccountCreate": {"allOf": [{"$ref": "#/components/schemas/ExternalIMAPAccountUpdate"}, {"type": "object", "required": ["mailboxId", "host", "username", "password"]}]},
      "WebmailComposeRequest": {"type": "object", "properties": {"mailboxId": {"type": "string"}, "from": {"type": "string"}, "fromName": {"type": "string"}, "to": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "cc": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "bcc": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "subject": {"type": "string"}, "text": {"type": "string"}, "html": {"type": "string"}, "attachments": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/AttachmentInput"}}, "externalAccountId": {"type": "string", "description": "Owned enabled sending account linked to the selected owned mailbox. Header/envelope From are forced; request from ignored."}}},
      "ExternalQueuedSend": {"type": "object", "required": ["queued", "queueId", "externalAccountId"], "properties": {"queued": {"const": true}, "queueId": {"type": "string"}, "externalAccountId": {"type": "string"}}},
      "ExternalSend": {"type": "object", "required": ["id", "status", "subject", "recipients", "createdAt", "updatedAt", "lastError", "sentCopyStatus"], "properties": {"id": {"type": "string"}, "status": {"type": "string", "enum": ["queued", "sending", "delivered", "failed", "unconfirmed", "canceled"]}, "subject": {"type": "string", "description": "Decoded at enqueue, control characters removed, truncated to 300 Unicode characters. Lists read this column without loading MIME.", "maxLength": 300}, "recipients": {"type": "array", "items": {"type": "string"}}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "lastError": {"type": "string", "description": "Empty, external account removed, or a stable external SMTP error code; never raw server text."}, "sentCopyStatus": {"type": "string", "enum": ["none", "pending", "done", "failed"]}}, "description": "MIME retained only while queued/sending/retryable failed/unconfirmed or pending APPEND. Cleared after delivery without APPEND, APPEND completion/final failure, terminal SMTP failure, or cancellation. Terminal external records with cleared MIME cannot be requeued."},
      "ExternalSMTPErrorCode": {"type": "string", "enum": ["external_smtp_auth_disabled", "external_smtp_auth_failed", "external_smtp_rejected", "external_smtp_temporary", "external_smtp_unconfirmed", "external_account_unavailable", "external_reauthorization_required"]},
      "AdminDeliveryQueueItem": {"type": "object", "required": ["id", "queueType", "route", "status", "attemptCount", "maxAttempts", "createdAt", "updatedAt"], "properties": {"id": {"type": "string"}, "queueType": {"type": "string", "enum": ["send", "webhook", "telegram"]}, "route": {"type": "string", "enum": ["relay", "external"], "description": "Non-send tasks use relay."}, "status": {"type": "string", "enum": ["pending", "failed", "delivered", "canceled", "unconfirmed"]}, "attemptCount": {"type": "integer"}, "maxAttempts": {"type": "integer"}, "nextAttemptAt": {"type": "string"}, "lastError": {"type": "string"}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}, "deliveredAt": {"type": "string"}}},
      "WebmailDraftRequest": {"type": "object", "description": "externalAccountId is validated but currently not persisted/read back for drafts; choose sender again when reopening. Scheduled-send payloads preserve it independently.", "properties": {"mailboxId": {"type": "string"}, "from": {"type": "string"}, "fromName": {"type": "string"}, "to": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "cc": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "bcc": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "email"}}, "subject": {"type": "string"}, "text": {"type": "string"}, "html": {"type": "string"}, "attachments": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/AttachmentInput"}}, "externalAccountId": {"type": "string", "description": "Owned enabled sending account linked to the selected owned mailbox. Header/envelope From are forced; request from ignored."}}},
      "ExternalIMAPOAuthStart": {"type": "object", "description": "New connection requires mailboxId; reauthorization may supply accountId and omit mailboxId. accountId must belong to the current user and match OAuth provider.", "properties": {"mailboxId": {"type": "string"}, "accountId": {"type": "string"}, "name": {"type": "string"}, "email": {"type": "string", "description": "Optional expected provider email; never defaults to local mailbox address."}, "storageMode": {"type": "string", "enum": ["local", "remote"], "default": "local"}, "syncReadState": {"type": "boolean", "default": true}, "enabled": {"type": "boolean", "default": true}}},
